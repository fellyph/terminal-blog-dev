{
  "name": "terminal-blog-dev",
  "version": "1.3.0",
  "description": "A retro terminal-inspired WordPress block theme with CRT aesthetics",
  "author": "fellyph",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "build:css": "node scripts/build-css.cjs",
    "check:css": "node scripts/build-css.cjs --check",
    "preplugin-zip": "npm run build:css",
    "plugin-zip": "wp-scripts plugin-zip",
    "lint:css": "wp-scripts lint-style 'assets/css/**/*.css' --ignore-pattern '**/*.min.css'",
    "lint:js": "wp-scripts lint-js 'assets/js/**/*.js'",
    "test:theme-toggle": "node --test tests/theme-toggle.test.cjs",
    "test:agent-readiness": "php tests/agent-readiness.php && node --test tests/agent-readiness-http.test.cjs"
  },
  "files": [
    "assets",
    "parts",
    "patterns",
    "includes",
    "templates",
    "functions.php",
    "screenshot.png",
    "style.css",
    "theme.json"
  ],
  "keywords": [
    "wordpress",
    "theme",
    "block-theme",
    "terminal"
  ],
  "devDependencies": {
    "@wordpress/scripts": "31.8.0",
    "cssnano": "6.1.2",
    "postcss": "8.5.25",
    "puppeteer": "^25.4.0",
    "typescript": "5.3.3"
  }
}
